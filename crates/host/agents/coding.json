    { "type": "builtin", "name": "write_file" },
    { "type": "builtin", "name": "edit_file" },
    { "type": "builtin", "name": "search_file" },
    { "type": "builtin", "name": "find_files" },
    { "type": "builtin", "name": "list_files" },
    { "type": "builtin", "name": "run_command" },
    { "type": "builtin", "name": "web_search" },
    { "type": "builtin", "name": "web_fetch" }
  ],
  "max_tool_rounds": 15
}
